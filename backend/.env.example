# ─────────────────────────────────────────────
# Skyline CRM — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# PostgreSQL connection string
# On Render this is injected automatically via render.yaml.
# Locally: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL=postgresql://crm_user:CHANGE_ME@localhost:5432/realestate_crm?schema=public

# JWT — use a long random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_SECRET
JWT_EXPIRATION=7d

# Encryption key for Housing.com / Apify credentials stored in the DB.
# Must be the SAME value across all restarts — changing it breaks saved credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_USE_LONG_RANDOM_SECRET

# URL of the deployed frontend — used for CORS.
# Set this to your Vercel deployment URL after deploying the frontend.
# Example: https://skyline-crm.vercel.app
FRONTEND_URL=http://localhost:3000

# Server port (Render sets this automatically)
PORT=4000
